/* pages/meetup-history/meetup-history.wxss */

.history-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 页面头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.header-left {
  display: flex;
  align-items: center;
  padding: 10rpx;
}

.back-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  flex: 1;
  text-align: center;
}

.header-right {
  display: flex;
  align-items: center;
}

.stats-btn {
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 28rpx;
  backdrop-filter: blur(10rpx);
}

/* 统计概览 */
.stats-overview {
  margin: 30rpx 30rpx 0;
}

.stats-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 15rpx;
  color: white;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 最近活跃度 */
.recent-activity {
  margin-top: 40rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.activity-chart {
  display: flex;
  align-items: end;
  justify-content: space-between;
  height: 120rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.chart-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.bar-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.bar-fill {
  width: 30rpx;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

.bar-count {
  font-size: 20rpx;
  color: #333;
  margin-top: 5rpx;
}

/* 筛选标签 */
.filter-tabs {
  margin: 30rpx 30rpx 0;
}

.tabs-scroll {
  white-space: nowrap;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-radius: 50rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
}

.tab-count {
  font-size: 24rpx;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

.filter-tab:not(.active) .tab-count {
  background: #f0f0f0;
  color: #666;
}

/* 记录列表 */
.history-list {
  height: calc(100vh - 500rpx);
  padding: 0 30rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.icon-emoji {
  font-size: 120rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #666;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 历史记录项 */
.history-item {
  margin-bottom: 30rpx;
}

.date-header {
  text-align: center;
  margin: 40rpx 0 20rpx;
}

.date-text {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.history-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.history-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #f0f0f0;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 5rpx;
}

.user-subtitle {
  font-size: 24rpx;
  color: #666;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.pending {
  background: #fff3cd;
  color: #856404;
}

.status-badge.accepted {
  background: #d4edda;
  color: #155724;
}

.status-badge.rejected {
  background: #f8d7da;
  color: #721c24;
}

.status-badge.cancelled {
  background: #d1ecf1;
  color: #0c5460;
}

.card-content {
  margin-bottom: 20rpx;
}

.meetup-info {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 15rpx;
  width: 30rpx;
  text-align: center;
}

.info-text {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  align-items: center;
}

.action-btn {
  padding: 10rpx 20rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-left: 15rpx;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn:active {
  transform: scale(0.95);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
}

.load-text {
  font-size: 26rpx;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-modal.show {
  opacity: 1;
  visibility: visible;
}

.detail-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
  transform: scale(0.9);
  transition: all 0.3s ease;
}

.detail-modal.show .detail-content {
  transform: scale(1);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
}

.detail-close {
  font-size: 36rpx;
  padding: 10rpx;
  line-height: 1;
}

.detail-body {
  padding: 40rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.detail-user {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.detail-user-info {
  flex: 1;
}

.detail-user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 5rpx;
}

.detail-user-owner {
  font-size: 26rpx;
  color: #666;
}

.detail-status {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.detail-status.pending {
  background: #fff3cd;
  color: #856404;
}

.detail-status.accepted {
  background: #d4edda;
  color: #155724;
}

.detail-status.rejected {
  background: #f8d7da;
  color: #721c24;
}

.detail-status.cancelled {
  background: #d1ecf1;
  color: #0c5460;
}

.detail-info {
  margin-top: 20rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
  width: 150rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.detail-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #f8f9fa;
}

.detail-btn {
  padding: 20rpx 40rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.detail-btn.secondary {
  background: #f0f0f0;
  color: #666;
}

.detail-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.detail-btn:active {
  transform: scale(0.95);
}

/* 统计详情弹窗 */
.stats-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.stats-modal.show {
  opacity: 1;
  visibility: visible;
}

.stats-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 650rpx;
  max-height: 80%;
  overflow: hidden;
  transform: scale(0.9);
  transition: all 0.3s ease;
}

.stats-modal.show .stats-content {
  transform: scale(1);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
}

.stats-close {
  font-size: 36rpx;
  padding: 10rpx;
  line-height: 1;
}

.stats-detail {
  padding: 40rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.stats-section {
  margin-bottom: 40rpx;
}

.stats-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.stats-list {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.stats-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.stats-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 26rpx;
  color: #666;
}

.item-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* 时间统计 */
.time-stats {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.time-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.time-item:last-child {
  margin-bottom: 0;
}

.time-label {
  font-size: 26rpx;
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.time-bar {
  flex: 1;
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 8rpx;
  margin: 0 15rpx;
  overflow: hidden;
}

.time-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.time-percent {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  width: 50rpx;
  text-align: right;
}

