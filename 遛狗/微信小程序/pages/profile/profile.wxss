/* pages/profile/profile.wxss */
.profile-container {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  padding: 20rpx;
}

/* 用户信息区域 */
.user-info-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.user-avatar {
  position: relative;
  margin-right: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #f0f0f0;
}

.avatar-edit-hint {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #007AFF;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.user-avatar:active .avatar-edit-hint {
  opacity: 1;
}

.user-details {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.user-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
  display: block;
}

.edit-btn {
  background: #007AFF;
  color: white;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.edit-btn:active {
  background: #005bb5;
  transform: scale(0.95);
}

/* 统计信息 */
.stats-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #007AFF;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 功能菜单 */
.menu-section {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.3s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 30rpx;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 快捷功能 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.action-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  flex: 1;
  margin: 0 10rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333;
  display: block;
}

/* 底部信息 */
.footer-section {
  text-align: center;
  margin-top: 50rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
  display: block;
}

.footer-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 40rpx;
}

.edit-modal {
  background: white;
  border-radius: 20rpx;
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.modal-close:active {
  background: #f0f0f0;
}

.modal-content {
  padding: 40rpx;
}

.edit-section {
  margin-bottom: 40rpx;
}

.edit-label {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.edit-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  transition: all 0.3s;
}

.edit-input:focus {
  border-color: #007AFF;
  background: white;
}

.edit-textarea {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  min-height: 120rpx;
  transition: all 0.3s;
}

.edit-textarea:focus {
  border-color: #007AFF;
  background: white;
}

/* 头像编辑 */
.avatar-edit {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.avatar-edit:active {
  border-color: #007AFF;
  background: #f8f8ff;
}

.edit-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-right: 20rpx;
}

.avatar-change-btn {
  flex: 1;
  text-align: center;
  color: #007AFF;
  font-size: 28rpx;
}

/* 宠物信息编辑 */
.pet-info-edit {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pet-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.field-label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.pet-field .edit-input {
  flex: 1;
}

/* 隐私设置 */
.privacy-settings {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.privacy-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.privacy-item:last-child {
  border-bottom: none;
}

.privacy-text {
  font-size: 28rpx;
  color: #333;
}

.privacy-switch {
  transform: scale(0.8);
}

/* 展示预览 */
.display-preview {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 30rpx;
  border: 1rpx solid #e0e0e0;
}

.preview-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.preview-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preview-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.preview-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  padding: 40rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.confirm-btn {
  background: #007AFF;
  color: white;
}

.confirm-btn:active {
  background: #005bb5;
}

/* 头像选择弹窗 */
.avatar-modal {
  background: white;
  border-radius: 20rpx;
  width: 100%;
  max-width: 500rpx;
  animation: modalSlideIn 0.3s ease-out;
}

.avatar-options {
  padding: 40rpx;
}

.avatar-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.avatar-option:last-child {
  margin-bottom: 0;
}

.avatar-option:active {
  background: #f8f8f8;
}

.option-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.option-text {
  font-size: 32rpx;
  color: #333;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .user-info-section {
    padding: 30rpx;
  }
  
  .avatar {
    width: 100rpx;
    height: 100rpx;
  }
  
  .username {
    font-size: 32rpx;
  }
  
  .user-desc {
    font-size: 24rpx;
  }
} 