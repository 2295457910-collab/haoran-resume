<!-- pages/chat/chat.wxml -->
<view class="chat-container">
  <!-- 聊天头部 -->
  <view class="chat-header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="header-center">
      <text class="chat-title">{{chatUser.name || '聊天'}}</text>
      <text class="chat-subtitle" wx:if="{{chatUser.owner}}">主人：{{chatUser.owner}}</text>
    </view>
    <view class="header-right">
      <view class="more-btn" bindtap="showMoreOptions">
        <text class="more-icon">⋯</text>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y="true" 
    scroll-top="{{scrollTop}}"
    scroll-with-animation="true"
    bindscrolltolower="loadMoreMessages"
    enable-back-to-top="true"
  >
    <!-- 消息项 -->
    <view class="message-item {{item.fromMe ? 'from-me' : 'from-other'}}" 
          wx:for="{{messages}}" 
          wx:key="id"
          bindlongpress="showMessageActions"
          data-message="{{item}}">
      
      <!-- 时间分割线 -->
      <view class="time-divider" wx:if="{{item.showTime}}">
        <text class="time-text">{{item.timeText}}</text>
      </view>

      <!-- 消息内容 -->
      <view class="message-content">
        <!-- 对方头像 -->
        <image 
          wx:if="{{!item.fromMe}}" 
          src="{{chatUser.avatar}}" 
          class="message-avatar" 
          mode="aspectFill"
        />
        
        <!-- 消息气泡 -->
        <view class="message-bubble {{item.fromMe ? 'bubble-me' : 'bubble-other'}}">
          <!-- 文本消息 -->
          <text wx:if="{{item.type === 'text'}}" class="message-text">{{item.content}}</text>
          
          <!-- 表情消息 -->
          <image 
            wx:if="{{item.type === 'emoji'}}" 
            src="{{item.content}}" 
            class="message-emoji" 
            mode="aspectFit"
          />
          
          <!-- 图片消息 -->
          <image 
            wx:if="{{item.type === 'image'}}" 
            src="{{item.content}}" 
            class="message-image" 
            mode="aspectFill"
            bindtap="previewImage"
            data-src="{{item.content}}"
          />
          
          <!-- 消息状态 -->
          <view class="message-status" wx:if="{{item.fromMe}}">
            <text wx:if="{{item.status === 'sending'}}" class="status-sending">发送中</text>
            <text wx:if="{{item.status === 'sent'}}" class="status-sent">已发送</text>
            <text wx:if="{{item.status === 'failed'}}" class="status-failed" bindtap="resendMessage" data-id="{{item.id}}">重发</text>
          </view>
        </view>
        
        <!-- 我的头像 -->
        <image 
          wx:if="{{item.fromMe}}" 
          src="{{userInfo.avatar}}" 
          class="message-avatar" 
          mode="aspectFill"
        />
      </view>
    </view>
    
    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{hasMoreMessages}}">
      <text class="load-text">加载更多...</text>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <!-- 工具栏 -->
    <view class="toolbar">
      <view class="tool-item" bindtap="toggleEmojiPanel">
        <text class="tool-icon {{showEmojiPanel ? 'active' : ''}}">😊</text>
      </view>
      <view class="tool-item" bindtap="chooseImage">
        <text class="tool-icon">📷</text>
      </view>
      <view class="tool-item" bindtap="showMoreTools">
        <text class="tool-icon">➕</text>
      </view>
    </view>
    
    <!-- 消息输入框 -->
    <view class="input-container">
      <textarea 
        class="message-input" 
        placeholder="输入消息..." 
        value="{{inputText}}"
        bindinput="onInputChange"
        bindconfirm="sendMessage"
        confirm-type="send"
        auto-height
        maxlength="1000"
        show-confirm-bar="false"
        cursor-spacing="20"
      />
      <view class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="sendMessage">
        <text class="send-text">发送</text>
      </view>
    </view>
  </view>

  <!-- 表情包面板 -->
  <view class="emoji-panel {{showEmojiPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <!-- 表情包标签 -->
    <view class="emoji-tabs">
      <view class="emoji-tab {{activeEmojiTab === 'default' ? 'active' : ''}}" 
            data-tab="default" 
            bindtap="switchEmojiTab">
        <text class="tab-text">😀</text>
      </view>
      <view class="emoji-tab {{activeEmojiTab === 'favorite' ? 'active' : ''}}" 
            data-tab="favorite" 
            bindtap="switchEmojiTab">
        <text class="tab-text">⭐</text>
      </view>
    </view>
    
    <!-- 表情包内容 -->
    <scroll-view class="emoji-content" scroll-y="true">
      <!-- 默认表情 -->
      <view class="emoji-grid" wx:if="{{activeEmojiTab === 'default'}}">
        <view class="emoji-item" 
              wx:for="{{defaultEmojis}}" 
              wx:key="id"
              bindtap="sendEmoji"
              data-emoji="{{item}}">
          <image src="{{item.url}}" class="emoji-img" mode="aspectFit" />
        </view>
      </view>
      
      <!-- 收藏表情 -->
      <view class="emoji-grid" wx:if="{{activeEmojiTab === 'favorite'}}">
        <!-- 添加表情按钮 -->
        <view class="emoji-item add-emoji-btn" bindtap="addCustomEmoji">
          <view class="add-emoji-icon">
            <text class="add-icon">+</text>
            <text class="add-text">添加</text>
          </view>
        </view>
        
        <!-- 收藏的表情 -->
        <view class="emoji-item" 
              wx:for="{{favoriteEmojis}}" 
              wx:key="id"
              bindtap="sendEmoji"
              bindlongpress="removeFavoriteEmoji"
              data-emoji="{{item}}">
          <image src="{{item.url}}" class="emoji-img" mode="aspectFit" />
        </view>
        
        <!-- 空状态 -->
        <view class="empty-favorite" wx:if="{{favoriteEmojis.length === 0}}">
          <text class="empty-text">还没有收藏表情</text>
          <text class="empty-desc">点击"+"号添加自定义表情</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 消息操作菜单 -->
  <view class="message-actions-modal {{showMessageActions ? 'show' : ''}}" bindtap="hideMessageActions">
    <view class="actions-content" catchtap="stopPropagation">
      <view class="action-item" bindtap="copyMessage">
        <text class="action-icon">📋</text>
        <text class="action-text">复制</text>
      </view>
      <view class="action-item" bindtap="favoriteEmoji" wx:if="{{selectedMessage.type === 'emoji'}}">
        <text class="action-icon">⭐</text>
        <text class="action-text">收藏</text>
      </view>
      <view class="action-item" bindtap="deleteMessage">
        <text class="action-icon">🗑️</text>
        <text class="action-text">删除</text>
      </view>
    </view>
  </view>

  <!-- 更多工具面板 -->
  <view class="more-tools-modal {{showMoreTools ? 'show' : ''}}" bindtap="hideMoreTools">
    <view class="tools-content" catchtap="stopPropagation">
      <view class="tool-grid">
        <view class="tool-item-large" bindtap="sendLocation">
          <text class="tool-icon-large">📍</text>
          <text class="tool-name">位置</text>
        </view>
        <view class="tool-item-large" bindtap="inviteMeetup">
          <text class="tool-icon-large">🐕</text>
          <text class="tool-name">约遛狗</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩层 -->
  <view class="overlay {{showMessageActions || showMoreTools ? 'show' : ''}}" 
        bindtap="hideAllModals"></view>
</view> 