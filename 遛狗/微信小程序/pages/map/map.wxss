/* pages/map/map.wxss */
.map-container {
  position: relative;
  width: 100%;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

/* 地图控件 */
.map-controls {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
}

.controls-left,
.controls-right {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.controls-right {
  align-items: flex-end;
}

.control-btn {
  min-width: 88rpx;
  min-height: 88rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.control-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.8);
}

.control-text {
  font-size: 32rpx;
  color: #374151;
  font-weight: 500;
}

.filter-btn {
  width: auto;
  padding: 16rpx 24rpx;
  flex-direction: row;
  gap: 12rpx;
}

/* 用户信息卡片 */
.user-card {
  position: absolute;
  bottom: -100%;
  left: 32rpx;
  right: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  z-index: 20;
}

.user-card.show {
  bottom: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.user-owner {
  font-size: 24rpx;
  color: #6b7280;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
  transition: all 0.2s ease;
}

.close-btn:active {
  background: #e5e7eb;
  transform: scale(0.9);
}

.card-info {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-icon {
  font-size: 28rpx;
}

.info-text {
  font-size: 24rpx;
  color: #374151;
}

.card-status {
  margin-bottom: 24rpx;
}

.status-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
}

.card-buttons {
  display: flex;
  gap: 24rpx;
}

.card-buttons .btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: all 0.2s ease;
}

.card-buttons .btn:active {
  transform: scale(0.98);
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag-chip {
  padding: 12rpx 20rpx;
  background: rgba(102, 126, 234, 0.12);
  color: #4338ca;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.card-highlight {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(250, 204, 21, 0.16);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.highlight-icon {
  font-size: 28rpx;
}

.highlight-text {
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.5;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.meta-text {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.card-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 24rpx;
  background: rgba(59, 130, 246, 0.08);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #1d4ed8;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

/* 筛选面板 */
.filter-panel {
  position: absolute;
  top: -100%;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 0 0 32rpx 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  z-index: 20;
  max-height: 80vh;
  overflow-y: auto;
}

.filter-panel.show {
  top: 0;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.filter-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
  transition: all 0.2s ease;
}

.filter-close:active {
  background: #e5e7eb;
  transform: scale(0.9);
}

.filter-section {
  margin-bottom: 40rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 24rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.filter-option.active {
  background: #dbeafe;
  color: #1d4ed8;
  border-color: #3b82f6;
}

.filter-option:active {
  transform: scale(0.95);
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f3f4f6;
}

.filter-actions .btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: all 0.2s ease;
}

.filter-actions .btn:active {
  transform: scale(0.98);
}

/* 遮罩层 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 15;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 开始遛狗按钮 */
.walking-btn {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 60rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  z-index: 30;
  transition: all 0.3s ease;
  min-width: 200rpx;
  justify-content: center;
}

.walking-btn:active {
  transform: translateX(-50%) scale(0.95);
}

.walking-btn.active {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  box-shadow: 0 8rpx 32rpx rgba(239, 68, 68, 0.4);
}

.btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}