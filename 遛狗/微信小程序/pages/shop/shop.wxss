/* pages/shop/shop.wxss */
.shop-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #f8fafc;
  padding: 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1f2937;
}

.content {
  text-align: center;
}

.placeholder {
  font-size: 32rpx;
  color: #6b7280;
} 