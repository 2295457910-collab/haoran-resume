/* pages/index/index.wxss */
.index-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.welcome {
  text-align: center;
  color: white;
}

.app-name {
  display: block;
  font-size: 72rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.app-desc {
  display: block;
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 80rpx;
}

.btn {
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  backdrop-filter: blur(10rpx);
}
